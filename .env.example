# Optional server binding (defaults: 0.0.0.0:3000)
HOST=0.0.0.0
PORT=3000

# Set this to a persistent directory outside the release folder in production.
# Windows example: ZOMBIX_DATA_DIR=D:\\ZombixData
# Linux example:   ZOMBIX_DATA_DIR=/var/lib/zombix
ZOMBIX_DATA_DIR=./server-data

# Set NODE_ENV=production behind HTTPS. Secure cookies are enabled by default
# in production; COOKIE_SECURE=false overrides this only when intentionally
# running without HTTPS (not recommended).
NODE_ENV=development
COOKIE_SECURE=false

# Optional private promo configuration path (must remain outside public/).
# ZOMBIX_PROMO_FILE=/etc/zombix/promo_codes.json
